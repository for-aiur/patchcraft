{
  "schemaVersion": 1,
  "id": "motion-pulse",
  "name": "Motion Pulse",
  "tagline": "More movement, more tremolo.",
  "description": "Frame-to-frame change drives tremolo depth. A looped clip makes the response easy to compare.",
  "image": {
    "stages": [
      {
        "module": "org.patchcraft.image.roi-crop",
        "version": 1,
        "enabled": true,
        "parameters": {
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 1
        },
        "id": "stage-1"
      },
      {
        "module": "org.patchcraft.image.grayscale",
        "version": 1,
        "enabled": true,
        "parameters": {
          "enabled": true
        },
        "id": "stage-2"
      },
      {
        "module": "org.patchcraft.image.tone",
        "version": 1,
        "enabled": true,
        "parameters": {
          "contrast": 1.3,
          "gamma": 1
        },
        "id": "stage-3"
      },
      {
        "module": "org.patchcraft.image.box-blur",
        "version": 1,
        "enabled": true,
        "parameters": {
          "radius": 2
        },
        "id": "stage-4"
      },
      {
        "id": "stage-4-measure",
        "module": "org.patchcraft.image.frame-difference",
        "version": 1,
        "enabled": true,
        "parameters": {}
      }
    ]
  },
  "weights": {
    "brightness": 0,
    "red": 0,
    "motion": 1
  },
  "midi": {
    "cc": 21,
    "channel": 1
  },
  "target": "Vital Tremolo Depth",
  "steps": [
    "Click Play demo scene or choose a video with visible movement.",
    "In Vital, open MIDI Learn on tremolo depth.",
    "Start MIDI output on CC 21, channel 1; motion drives tremolo depth.",
    "Focus the region on the moving shape to ignore unrelated changes."
  ],
  "routes": {
    "brightness": "",
    "red": "",
    "motion": "stage-4-measure|motion"
  },
  "smoothingMs": 80
}
