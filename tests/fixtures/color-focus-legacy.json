{
  "schemaVersion": 1,
  "id": "color-focus",
  "name": "Color Focus",
  "tagline": "A chosen color turns into drive.",
  "description": "The share of red pixels in the selected region controls a distortion or drive parameter.",
  "image": {
    "stages": [
      {
        "module": "org.patchcraft.image.roi-crop",
        "version": 1,
        "enabled": true,
        "parameters": {
          "x": 0.1,
          "y": 0.1,
          "width": 0.8,
          "height": 0.8
        },
        "id": "stage-1"
      },
      {
        "module": "org.patchcraft.image.grayscale",
        "version": 1,
        "enabled": false,
        "parameters": {
          "enabled": false
        },
        "id": "stage-2"
      },
      {
        "module": "org.patchcraft.image.tone",
        "version": 1,
        "enabled": true,
        "parameters": {
          "contrast": 1.2,
          "gamma": 0.9
        },
        "id": "stage-3"
      },
      {
        "module": "org.patchcraft.image.box-blur",
        "version": 1,
        "enabled": true,
        "parameters": {
          "radius": 1
        },
        "id": "stage-4"
      },
      {
        "id": "red-mask",
        "module": "org.patchcraft.image.threshold",
        "version": 1,
        "enabled": true,
        "parameters": {
          "channel": 4,
          "low": 0.95,
          "high": 0.05,
          "invert": false
        }
      },
      {
        "id": "red-mask-measure",
        "module": "org.patchcraft.image.mask-analysis",
        "version": 1,
        "enabled": true,
        "parameters": {}
      }
    ]
  },
  "weights": {
    "brightness": 0,
    "red": 1,
    "motion": 0
  },
  "midi": {
    "cc": 20,
    "channel": 1
  },
  "target": "Vital Distortion Drive",
  "steps": [
    "Click Play demo scene or choose a video with a color you want to track.",
    "In Vital, open MIDI Learn on the distortion drive control.",
    "Start MIDI output on CC 20, channel 1 and watch red coverage move the drive.",
    "Adjust the image region to focus on the moving red shape."
  ],
  "routes": {
    "brightness": "",
    "red": "red-mask-measure|coverage",
    "motion": ""
  },
  "smoothingMs": 80
}
