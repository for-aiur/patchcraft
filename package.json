{
  "name": "patchcraft",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json",
    "build": "npm run lint && vite build",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test": "npm run build && npm run test:unit && npm run test:integration && npm run test:browser",
    "server": "node --experimental-strip-types server/main.ts",
    "test:integration": "node --experimental-strip-types tests/retrieval.integration.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "dependencies": {
    "@langchain/core": "1.3.5",
    "@langchain/google": "0.2.12",
    "@langchain/langgraph": "1.7.2",
    "@langfuse/langchain": "6.1.1",
    "@langfuse/otel": "6.1.1",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
